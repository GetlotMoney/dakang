VITE_APP_TITLE='六维达康智慧水站'
VITE_APP_PORT=9000
VITE_UNI_APPID='__UNI__DAKANG_DEMO'
VITE_WX_APPID='touristappid'
VITE_API_MODE='mock'
# 日常 Demo/交付构建全域 Mock。真实微信登录未接入前，禁止默认包携带测试账号直通真实写链。
# device/order/card 的真实适配器代码保留给后续正式鉴权联调；只有验收专用构建才可显式覆盖为 real。
VITE_API_MODE_DEVICE='mock'
VITE_API_MODE_ORDER='mock'
VITE_API_MODE_CARD='mock'
# recharge 域在代码层固定 mock；L2 后端与验收门完成前，环境变量不能翻成 real。
VITE_API_MODE_RECHARGE='mock'
# auth 域（L2-AUTH 正式微信登录/绑手机）默认 mock，走 C01 原型入口；
# 仅正式鉴权联调/验收构建（且已配置真实微信 appid/secret 的后端）才显式覆盖为 real。
VITE_API_MODE_AUTH='mock'
# delivery 域（E2E-03 水配送链，包B）：交付构建保持全 Mock；仅联调/验收构建显式覆盖为 real。
VITE_API_MODE_DELIVERY='mock'
VITE_SERVER_BASEURL='http://localhost:13330/dakangApi'
