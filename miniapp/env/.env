VITE_APP_TITLE='六维达康智慧水站'
VITE_APP_PORT=9000
VITE_UNI_APPID='__UNI__DAKANG_DEMO'
# 微信小程序 AppID：本档入库，只放平台默认占位。
# 真实 AppID 写在**不入库**的 env/.env.development.local 里覆盖（模板见 .env.development.example）。
# 缺它只影响真机预览，工具内编译不受限。
VITE_WX_APPID='touristappid'
# 全部业务链恒接真实后端，运行前必须有可达的后端。mock 适配器与场景库已于 2026-08-02 删除，
# 按域切 mock 的解析层已于 2026-08-12 一并移除——没有任何回落实现，后端不通就是不通。
# 本机默认 localhost:13330；真机联调改 .env.development.local，构建钩子会自动校正 IP。
VITE_SERVER_BASEURL='http://localhost:13330/dakangApi'
# 微信「手机号快速验证」组件能力开关不在这里：环境变量注入曾在产物污染事故（残留 watch 编译器
# 各持旧 env 快照竞写 dist）中被证明不可信赖，且注入失败与关闭态无从区分。开关是
# src/api/runtime.ts 的 WX_PHONE_COMPONENT_AVAILABLE 常量（主体已认证，当前为 true）。
