NODE_ENV='development'
VITE_DELETE_CONSOLE='false'

# ---------------------------------------------------------------------------
# 本机联调档模板：复制为同目录 **.env.development.local** 后改成自己的值。
#
# 为什么是 .local 而不是直接改 .env.development：
#   .env.development 是入库的公开安全档（localhost + 占位 AppID），
#   改它等于把某台机器的局域网 IP 与 AppID 推给所有人；
#   .local 的 vite 优先级更高，且已被 .gitignore 的 **/.env.*.local 排除。
#
# 仅 dev 构建生效；build:mp-weixin 走 .env.production，落回 .env 的 localhost 与占位 AppID。
#
# 真机上 localhost 指向手机自己，必须用本机在局域网里的地址，手机与 Mac 要在同一 Wi-Fi。
# 换网络后 IP 会变，改这一行即可。
VITE_SERVER_BASEURL='http://<你的局域网IP>:13330/dakangApi'

# 真机预览用的小程序 AppID（覆盖 env/.env 的 touristappid 占位）；
# 填你自己小程序后台的 AppID，登录开发者工具的微信号需是该小程序的项目成员。
VITE_WX_APPID='wx<你的小程序AppID>'
