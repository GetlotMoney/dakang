NODE_ENV='development'
VITE_DELETE_CONSOLE='false'

# ---------------------------------------------------------------------------
# 本机联调档模板：复制为同目录 **.env.development.local** 后改成自己的值。
#
# 为什么是 .local 而不是直接改 .env.development：
#   .env.development 是入库的公开安全档（全域 Mock、localhost、测试登录关闭），
#   改它等于把某台机器的局域网 IP、AppID 与账号白名单推给所有人；
#   .local 的 vite 优先级更高，且已被 .gitignore 的 **/.env.*.local 排除。
#
# L2-T 真机联调档（仅 dev 构建生效；build:mp-weixin 走 .env.production，仍是 .env 里的全域 Mock）
#
# 真机上 localhost 指向手机自己，必须用本机在局域网里的地址，手机与 Mac 要在同一 Wi-Fi。
# 换网络后 IP 会变，改这一行即可。
VITE_SERVER_BASEURL='http://<你的局域网IP>:13330/dakangApi'

# 业务域接真：卡详情、套餐、创单、支付状态、订单列表全部打真实后端。
VITE_API_MODE_DEVICE='real'
VITE_API_MODE_ORDER='real'
VITE_API_MODE_CARD='real'
VITE_API_MODE_RECHARGE='real'
# E2E-03 水配送链（包B）：配送下单/任务/三照/申诉打真实后端。
VITE_API_MODE_DELIVERY='real'
VITE_API_MODE_MESSAGE='real'

# auth 仍走 C01 原型账号入口：wechat.xcx 的 appid/appsecret 未配置，
# 翻 real 只会在真机上卡在登录，反而点不进业务。
VITE_API_MODE_AUTH='mock'

# 测试登录手机号：必须是库里已存在且可用的账号（后端只认已存在身份，不会创建账号）。
# 后端 /mini/test-login/** 与 Pay-Sim 同一个 MINI_PAYSIM_ENABLED 开关门控，生产不注册。
VITE_TEST_LOGIN_PHONE='<库中已存在的测试手机号>'

# 测试账号白名单（手机号:标签，逗号分隔）：入口自动登录仍用上面的默认号；
# 「我的 → 退出登录」后入口停在选号页，一台真机切换角色走通业务链（如配送双端）。
# 号码必须是库里已存在且可用的账号；与 Pay-Sim 同闸，交付构建不配置即无此入口。
VITE_TEST_LOGIN_PHONES='<手机号>:<角色标签·下单>,<手机号>:<角色标签·配送员>'

# 真机预览用的小程序 AppID（覆盖 env/.env 的 touristappid 占位）；
# 填你自己小程序后台的 AppID，登录开发者工具的微信号需是该小程序的项目成员。
VITE_WX_APPID='wx<你的小程序AppID>'
