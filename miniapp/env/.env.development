NODE_ENV='development'
VITE_DELETE_CONSOLE='false'

# Public development builds are fail-safe: every business domain stays on Mock.
# Create a local, ignored override only for controlled integration testing.
VITE_SERVER_BASEURL='http://localhost:13330/dakangApi'
VITE_API_MODE_AUTH='mock'
VITE_API_MODE_DEVICE='mock'
VITE_API_MODE_ORDER='mock'
VITE_API_MODE_CARD='mock'
VITE_API_MODE_RECHARGE='mock'
VITE_API_MODE_DELIVERY='mock'

# Test-login is deliberately disabled in the public development profile.
VITE_TEST_LOGIN_PHONE=''
