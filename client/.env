# 【通用】环境变量

#  版本号
VITE_VERSION = 3.0.2

# Vite 开发预览端口（仅 HMR；PC Demo 唯一验收入口是 Nginx 8081）
VITE_PORT = 13321

# 后端路径
VITE_API_URL = http://localhost:13330/dakangApi

VITE_API_PROXY_URL = http://localhost:13330/dakangApi

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = ./


# 权限模式【 frontend 前端模式 / backend 后端模式 】
VITE_ACCESS_MODE = backend

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息
VITE_OPEN_ROUTE_INFO = false

# 锁屏加密密钥
VITE_LOCK_ENCRYPT_KEY = s3cur3k3y4adpro

