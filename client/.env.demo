# 【本地 Demo】仅供 deploy/build-all.sh 构建 localhost:8081 的演示站点。
# 预填只是把登录框填好，不绕过滑块，也不绕过后端鉴权。
#
# 安全边界：下面这组账号是 deploy/mysql/init/01-base.sql 里的 Demo 管理员，
# 与该文件中的 RSA 口令密文配套，公开即等同明文，**只可用于本机演示**。
# 任何对外可达的部署都必须：删除本文件（或置 VITE_DEMO_LOGIN_AUTOFILL=false）、
# 重置管理员口令、更换 RSA 密钥对。普通 production 构建不读取本文件。

VITE_BASE_URL = /
VITE_API_URL = /
VITE_DROP_CONSOLE = true

VITE_DEMO_LOGIN_AUTOFILL = true
VITE_DEMO_LOGIN_USERNAME = admin
VITE_DEMO_LOGIN_PASSWORD = 123456
