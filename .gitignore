# --- 构建产物 ---
server/target/
client/dist/
miniapp/dist/
deploy/dist/
deploy/logs/
# 任意层级的依赖目录（含 tools/*/node_modules）
node_modules/

# --- IDE / 系统 ---
.idea/
.vscode/
.DS_Store
*.iml
# Cursor 规则、MCP 会话和本机插件路径均不得进入共享源码。
.cursor/
# Codex 本机会话与配置同理。
.codex/

# --- 日志与临时 ---
*.log
logs/
tmp/
# 配送受控媒体等运行时文件不得混入源码或交付包。
# 注意锚点：媒体落盘目录随进程工作目录而变（后端在仓库根、设备模拟器在
# tools/device-sim/），只写 /data/ 只挡得住根目录那一份；真机上传的签收照片
# 是带 EXIF 的真实图片，任何一份漏进公开仓库都是隐私事故，故按目录名全层级排除。
/data/
**/data/delivery-media/

# --- 测试与中间产物（临时快照和截图不进入源码） ---
.playwright-mcp/
miniapp/e2e/*.png
# 仓库根目录一律不放散落截图（验收证据应落 docs/acceptance/）
/*.png
/*.jpg
/*.jpeg

# 水卡生命周期验收环境运行时产物（pid/日志），证据统一存放在 docs/acceptance/
deploy/acceptance/.run/

# --- 敏感（凭据一律外置，不入库） ---
**/application-secret*.yml
# 两个目录都要挡：单数 backup/ 是实际在用的那个（含主库 dump 与 jar 备份），
# 此前只写了复数 backups/，导致 490MB 备份既未被忽略、也未被交付脚本排除。
deploy/backups/
deploy/backup/
# 数据库转储与 JAR/产物备份无论落在哪个目录都不入库
*.bak
*.sql.gz

# 仓库根 .env 是全仓唯一的口令来源；只有模板 .env.example 入库。
/.env
!/.env.example
# docker compose 只读取「compose 文件所在目录」的 .env，故这两处是指向根 .env 的软链，同样不入库。
/deploy/.env
/deploy/acceptance/.env
# 各前端工程的本机覆盖档。
**/.env.local
**/.env.*.local
# 说明：miniapp/env/.env.development 是**入库**的公开安全档（全域 Mock、localhost、
# 测试登录关闭），别人 clone 下来即可用。本机联调值（局域网 IP、真实 AppID、
# 测试账号白名单）写进同目录 .env.development.local——vite 优先级更高且已被
# 上面的 **/.env.*.local 排除，模板见 .env.development.example。
# 私钥/证书任何形态都不入库。
*.pem
*.key
*.p12
*.pfx
__pycache__/
.claude/
