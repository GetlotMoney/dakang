# 六维达康 · 凭据模板
#
# 用法：cp .env.example .env，然后把下面的空值填成本机真值。
# .env 已在 .gitignore 里排除，**永远不入库**；本模板只保留键名、注释与安全默认值。
# 谁读它：
#   - deploy/docker-compose.yml、deploy/acceptance/docker-compose.acc.yml
#     （通过 deploy/.env、deploy/acceptance/.env 两个指向本文件同目录 .env 的软链读取，
#       因为 docker compose 只认「compose 文件所在目录」的 .env）
#   - deploy/acceptance/acc-env.sh（脚本开头 source 仓库根 .env）
#   - 后端 Spring 配置（application*.yml 里写的是同名 ${变量}）
#   - 手工执行 SQL / 跑 e2e 前：set -a; . .env; set +a
# 带 :? 标记的变量在 compose 里是强制项，缺失即拒绝启动（fail-closed，不会静默用空口令跑起来）。

# ---------------------------------------------------------------------------
# 主环境（deploy/docker-compose.yml，MySQL 3308 / Redis 6380 / EMQX 1883,18083）
# ---------------------------------------------------------------------------

# 主库账号，默认 root（MySQL 容器以 root 初始化）
DAKANG_DB_USERNAME=root

# 主库 root 口令：compose 用它初始化 MySQL、做 healthcheck，后端也用它连库。必填。
DAKANG_DB_PASSWORD=

# 主 Redis 的 requirepass；后端 spring.redis / 限流器共用。必填。
DAKANG_REDIS_PASSWORD=

# EMQX 管理台 admin 的口令（http://localhost:18083）。必填。
DAKANG_EMQX_DASHBOARD_PASSWORD=

# MQTT 接入账号：当前 EMQX 未开认证，留空即匿名接入；
# 生产必须开启设备认证并在这里配置后端接入 Broker 用的账号口令。
DAKANG_MQTT_USERNAME=
DAKANG_MQTT_PASSWORD=

# sa-token 签发 JWT 用的密钥：必须是本项目专属随机值。
# 与其他基座项目共用同一串会让两边的 token 可互相伪造。必填。
DAKANG_JWT_SECRET=

# PC 登录口令传输用的 RSA 密钥对（Base64，无 PEM 头尾；私钥 PKCS#8、公钥 X.509）。
# 口令传输用 RSA 密钥对（前端用公钥加密登录口令，后端用私钥解密）。
# **必填**：源码内不保留任何密钥，缺失时后端直接拒绝启动。两个变量必须成对填写。
#
# 生成一对（PKCS#8 私钥 + X.509 公钥，均为单行 base64、不含 PEM 头尾）：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:1024 -outform DER 2>/dev/null | base64 | tr -d '\n'
#   （公钥：openssl rsa -in <私钥pem> -pubout -outform DER | base64 | tr -d '\n'）
#
# 填好后还要做两件事，否则 PC 登不进去：
#   1) 把公钥同步到 client/.env 的 VITE_ACCESS_LOGIN_KEY —— 前后端必须是同一把公钥；
#   2) 重置管理员口令。deploy/mysql/init/01-base.sql 与 acceptance/acc-seed.sql 里
#      admin / acc-ops 的固定密文是用**另一对**密钥加密的，换密钥后它们解不出来。
DAKANG_RSA_PRIVATE_KEY=
DAKANG_RSA_PUBLIC_KEY=

# 微信小程序凭据：主体已完成微信认证、AppID 已固定，正式登录已接入。
# AppID 与 AppSecret 同按凭据管理，本文件只留变量名不留真值。
# 留空**不会**回落到任何原型入口——code2session 与手机号解析两个适配器都是 fail-closed，
# 清空即整条登录链立刻失效。排障时不要用「清空凭据」作为隔离手段。
# AppSecret 属真实密钥，只能放这里，禁止写回 application*.yml。
WECHAT_XCX_APPID=
WECHAT_XCX_APPSECRET=

# Pay-Sim 模拟支付开关。安全默认 false：一旦误开，模拟收款会被当成真实微信收款记账。
# 演示/联调环境显式置 true。
# 注意它**不再**门控测试登录：D-425 已把按手机号直签会话的 /mini/test-login 拆到
# 独立开关 MINI_TEST_LOGIN_ENABLED（本文件刻意不列，缺配即关，只有隔离验收环境
# 在 acc-env.sh 里显式开）。开 Pay-Sim 不会打开身份绕过，反之亦然。。生产必须保持 false。
MINI_PAYSIM_ENABLED=false

# 商城 Pay-Sim 独立开关。只在 E2E-09 隔离验收获单次授权后置 true；生产保持 false。
MALL_PAYSIM_ENABLED=false

# Refund-Sim 模拟退款开关。安全默认 false：一旦误开，模拟退款会被当成真实微信退款记账，
# 账面显示已退款而用户一分钱没收到。关闭时退款走 fail-closed 适配器直接拒绝。
# 演示环境要演示 E2E-04 售后退款链才显式置 true（与 Pay-Sim 同开合才口径对称）。生产必须保持 false。
MINI_REFUNDSIM_ENABLED=false
# 商城模拟退款（E2E-09 S4）：与上面三个模拟开关各自独立授权。退款是出账，
# 受控演示用完必须改回 false。生产环境恒为 false。
MALL_REFUNDSIM_ENABLED=false

# 商城第三方承运商模拟适配器（E2E-09 L1）。关闭时 LogisticsSimAdapter 不注册，
# 「创建运单」一律被 requireRegisteredProvider 拒绝，PC 承运商下拉为空——
# 这是 fail-closed 的正确行为，但也意味着第三方物流链在关闭态下完全不可演示。
# 它会产生对外运单动作，与收款/退款同级别按需授权。生产接真实承运商前恒为 false。
MALL_LOGISTICSSIM_ENABLED=false

# 老板测试配送联动（仅与 deploy/docker-compose.demo.yml 一起使用）。
# 老板手机号只写服务器私有 .env，禁止提交；虚拟配送员和水站使用初始化种子的稳定业务键。
DELIVERY_DEMOSIM_CUSTOMER_PHONE=
DELIVERY_DEMOSIM_COURIER_PHONE=13800001111
DELIVERY_DEMOSIM_STATION_CODE=WS-WH-001

# 仅微信身份建号开关（= 游客态）。**本文件的 false 是"新环境安全默认"，不是生产目标值。**
#
# 【2026-08-12 口径变更，D-426】此开关最初是主体未过微信认证时的权宜（组件层禁用
# getPhoneNumber，新用户拿不到 phoneCode，注册链断死）。认证已完成，但产品口径同时改成
# **游客态**：进入即可浏览，只在涉及资金/履约/责任主体时才要求绑号（MiniPhoneGate，627）。
# 因此本开关在生产 .env 里是 **true**，且不再随认证状态回收——原注释那句「完成微信认证后
# 撤回 false」若照做，会让新用户在注册环节就被要求授权手机号，当场违反运营规范 15.1.3.1
# 与 D-426，且游客态整条动线失效。
#
# 置 false 的后果（strict 模式）：注册即绑号，bindTicket 票据链重新可达。
# 两种模式都受支持，但**必须与端上口径一致**，不可只改一侧。
MINI_PHONELESS_REGISTER_ENABLED=false

# ---------------------------------------------------------------------------
# 水卡生命周期验收环境（deploy/acceptance/*，MySQL 3309 / Redis 6381 / EMQX 1884,18084）
# 与主环境物理隔离，容器组独立，绝不触碰主库。
# ---------------------------------------------------------------------------

# 验收库 root 口令。**必须与 DAKANG_DB_PASSWORD 不同**：
# 这样脚本误把连接指到 3308（主库）时会认证失败，形成第二道防触主库护栏；配成同一个口令这道护栏就没了。
DAKANG_ACC_DB_PASSWORD=

# 验收 Redis 的 requirepass（同样建议与主环境不同）。
DAKANG_ACC_REDIS_PASSWORD=

# 验收 EMQX 管理台 admin 口令（http://localhost:18084）。
DAKANG_ACC_EMQX_DASHBOARD_PASSWORD=

# miniapp/e2e/run-card-lifecycle.js 连验收库用的口令，取值与 DAKANG_ACC_DB_PASSWORD 相同。
# 脚本无硬编码兜底，缺失即拒绝执行。
ACC_DB_PASSWORD=

# 验收运营账号 acc-ops 的登录口令密文（RSA 密文，与 deploy/acceptance/acc-seed.sql 里
# 该账号的 LOGIN_PWD 必须一字不差）。换过 RSA 密钥对或重置过口令后，这里要同步换成新密文。
ACC_OPS_PWD_CIPHER=

# ==================== 微信支付 APIv3（WX-ECO S3）====================
# 六项缺任何一项即视为未配置，所有支付组件 fail-closed。真值不得提交仓库。

# 商户号
WECHAT_PAY_MCHID=

# 商户 API 证书序列号（出站请求 Authorization 头的 serial_no）
WECHAT_PAY_MERCHANT_SERIAL=

# 商户私钥 PEM 文件路径（PKCS#8；容器内建议 secret 挂载路径）
WECHAT_PAY_PRIVATE_KEY_PATH=

# APIv3 密钥（32 字节；回调 resource 解密用）
WECHAT_PAY_API_V3_KEY=

# 微信支付平台公钥 ID（回调头 Wechatpay-Serial 必须与之一致）
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=

# 平台公钥 PEM 文件路径（X.509）
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=

# 三个微信出站适配器开关：默认 false=fail-closed 兜底实现在位（恒拒绝/不发/Worker 休眠）。
# 商户凭据齐备且获真实环境联调授权后逐项置 true。
WECHAT_PAY_HTTP_CLIENT_ENABLED=false
WECHAT_NOTIFY_HTTP_SENDER_ENABLED=false
WECHAT_SHIPPING_HTTP_CLIENT_ENABLED=false
