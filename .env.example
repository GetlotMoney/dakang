# 六维达康 · 凭据模板
#
# 用法：cp .env.example .env，然后把下面的空值填成本机真值。
# .env 已在 .gitignore 里排除，**永远不入库**；本模板只保留键名、注释与安全默认值。
# 谁读它：
#   - deploy/docker-compose.yml、deploy/acceptance/docker-compose.acc.yml
#     （通过 deploy/.env、deploy/acceptance/.env 两个指向本文件同目录 .env 的软链读取，
#       因为 docker compose 只认「compose 文件所在目录」的 .env）
#   - deploy/acceptance/acc-env.sh（脚本开头 source 仓库根 .env）
#   - 后端 Spring 配置（application*.yml 里写的是同名 ${变量}）
#   - 手工执行 SQL / 跑 e2e 前：set -a; . .env; set +a
# 带 :? 标记的变量在 compose 里是强制项，缺失即拒绝启动（fail-closed，不会静默用空口令跑起来）。

# ---------------------------------------------------------------------------
# 主环境（deploy/docker-compose.yml，MySQL 3308 / Redis 6380 / EMQX 1883,18083）
# ---------------------------------------------------------------------------

# 主库账号，默认 root（MySQL 容器以 root 初始化）
DAKANG_DB_USERNAME=root

# 主库 root 口令：compose 用它初始化 MySQL、做 healthcheck，后端也用它连库。必填。
DAKANG_DB_PASSWORD=

# 主 Redis 的 requirepass；后端 spring.redis / 限流器共用。必填。
DAKANG_REDIS_PASSWORD=

# EMQX 管理台 admin 的口令（http://localhost:18083）。必填。
DAKANG_EMQX_DASHBOARD_PASSWORD=

# MQTT 接入账号：当前 EMQX 未开认证，留空即匿名接入；
# 生产必须开启设备认证并在这里配置后端接入 Broker 用的账号口令。
DAKANG_MQTT_USERNAME=
DAKANG_MQTT_PASSWORD=

# sa-token 签发 JWT 用的密钥：必须是本项目专属随机值。
# 与其他基座项目共用同一串会让两边的 token 可互相伪造。必填。
DAKANG_JWT_SECRET=

# PC 登录口令传输用的 RSA 密钥对（Base64，无 PEM 头尾；私钥 PKCS#8、公钥 X.509）。
# 留空则回落到源码内置的 **Demo 密钥对**——它随源码公开，等同已泄漏，
# 口令传输用 RSA 密钥对（前端用公钥加密登录口令，后端用私钥解密）。
# **必填**：源码内不保留任何密钥，缺失时后端直接拒绝启动。两个变量必须成对填写。
#
# 生成一对（PKCS#8 私钥 + X.509 公钥，均为单行 base64、不含 PEM 头尾）：
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:1024 -outform DER 2>/dev/null | base64 | tr -d '\n'
#   （公钥：openssl rsa -in <私钥pem> -pubout -outform DER | base64 | tr -d '\n'）
#
# 填好后还要做两件事，否则 PC 登不进去：
#   1) 把公钥同步到 client/.env 的 VITE_ACCESS_LOGIN_KEY —— 前后端必须是同一把公钥；
#   2) 重置管理员口令。deploy/mysql/init/01-base.sql 与 acceptance/acc-seed.sql 里
#      admin / acc-ops 的固定密文是用**另一对**密钥加密的，换密钥后它们解不出来。
DAKANG_RSA_PRIVATE_KEY=
DAKANG_RSA_PUBLIC_KEY=

# 微信小程序凭据：正式登录（wechat.xcx）接入前保持空，留空时 auth 域走原型入口。
# AppSecret 属真实密钥，只能放这里，禁止写回 application*.yml。
WECHAT_XCX_APPID=
WECHAT_XCX_APPSECRET=

# Pay-Sim 模拟支付开关。安全默认 false：一旦误开，模拟收款会被当成真实微信收款记账。
# 演示/联调环境显式置 true（它同时门控 /mini/test-login 测试登录路由）。生产必须保持 false。
MINI_PAYSIM_ENABLED=false

# ---------------------------------------------------------------------------
# 水卡生命周期验收环境（deploy/acceptance/*，MySQL 3309 / Redis 6381 / EMQX 1884,18084）
# 与主环境物理隔离，容器组独立，绝不触碰主库。
# ---------------------------------------------------------------------------

# 验收库 root 口令。**必须与 DAKANG_DB_PASSWORD 不同**：
# 这样脚本误把连接指到 3308（主库）时会认证失败，形成第二道防触主库护栏；配成同一个口令这道护栏就没了。
DAKANG_ACC_DB_PASSWORD=

# 验收 Redis 的 requirepass（同样建议与主环境不同）。
DAKANG_ACC_REDIS_PASSWORD=

# 验收 EMQX 管理台 admin 口令（http://localhost:18084）。
DAKANG_ACC_EMQX_DASHBOARD_PASSWORD=

# miniapp/e2e/run-card-lifecycle.js 连验收库用的口令，取值与 DAKANG_ACC_DB_PASSWORD 相同。
# 脚本无硬编码兜底，缺失即拒绝执行。
ACC_DB_PASSWORD=

# 验收运营账号 acc-ops 的登录口令密文（RSA 密文，与 deploy/acceptance/acc-seed.sql 里
# 该账号的 LOGIN_PWD 必须一字不差）。换过 RSA 密钥对或重置过口令后，这里要同步换成新密文。
ACC_OPS_PWD_CIPHER=
