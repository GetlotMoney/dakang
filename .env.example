# Copy this file to .env and replace every placeholder with a unique value.
# Never commit the generated .env file.

DAKANG_DB_USERNAME=root
DAKANG_DB_PASSWORD=
DAKANG_REDIS_PASSWORD=

DAKANG_MQTT_USERNAME=
DAKANG_MQTT_PASSWORD=
DAKANG_EMQX_DASHBOARD_PASSWORD=

# Use a long, random value.
DAKANG_JWT_SECRET=

# Base64-encoded RSA key material used by the legacy employee-password flow.
# Production deployments should migrate employee passwords to one-way hashes.
DAKANG_RSA_PRIVATE_KEY=
DAKANG_RSA_PUBLIC_KEY=

# Keep disabled unless running the isolated acceptance environment.
MINI_PAYSIM_ENABLED=false

DAKANG_ACC_DB_PASSWORD=
DAKANG_ACC_REDIS_PASSWORD=
DAKANG_ACC_EMQX_DASHBOARD_PASSWORD=
ACC_DB_PASSWORD=
