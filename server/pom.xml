    <profiles>
        <!--
          迭代提速档：`mvn -o test -Pfast`，只跑 103 个纯逻辑测试类（约 33 秒），
          跳过 45 个 *DbTest（它们占全量 7:48 里的 98%，见 surefire 注释处的实测数据）。

          【为什么是显式档，而不是把全量改成需要加参数】
          反过来做迟早会有人拿 33 秒的绿去交付：跳过的恰恰是事务两段式、CAS 影响行数、
          并发与幂等这些只有真库才验得出的判据，而这些正是本项目历次 P0 的所在地。
          让快档必须被手敲出来，敲的人就知道自己跳过了什么。

          【什么时候必须跑全量】改动落到 server/ 任一处后的交付节点、移交审计前、封板前。
          【判据为什么可靠】45 个真库类 100% 以 DbTest 结尾（2026-08-12 核过），
          新增真库测试若不守这个后缀，会被 fast 档漏跑——所以命名不是风格问题。
        -->
        <profile>
            <id>fast</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/*DbTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

