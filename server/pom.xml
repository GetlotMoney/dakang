    <build>
        <!-- 产物固定名：deploy/docker-compose.yml 与 build-all.sh 均按此名挂载 -->
        <finalName>dakang-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!--
                  测试并行分叉。全量套件的时间几乎全部花在容器启动上：148 个测试类里有 45 个
                  用 Testcontainers，每类一个 MySQL 实例，串行执行时这些启动时间纯粹相加
                  （实测 11 分 20 秒）。

                  2026-08-12 复量（1711 条 / fork=4 / 墙钟 7:48）：
                    45 个 *DbTest 累计 1378.9s，其余 103 个类累计合计 33.3s——真库占 98%；
                    其中光是启动 45 次 MySQL 就用掉 617.0s（均 13.7s，最长 17.3s），占真库时间的 45%。
                  这 617 秒是可以消灭的：45 个容器只是库名不同（it / dakang_gift_it / …），
                  改成「一个实例 + 每类 CREATE DATABASE 自己的库」即可降到每 fork 一次，隔离性不变。
                  尚未做，因为要动 45 个测试类；日常提速先用下面的 fast profile。

                  选 fork 级并行而不是线程级：每个 fork 是独立 JVM，容器、静态单例与 Spring
                  上下文都天然隔离，不需要审查每个测试类是否线程安全——线程级并行则要求
                  所有共享可变状态都被证明安全，那是一次全量审查的工作量，收益却相同。

                  forkCount 取 4 是量出来的，不是猜的（8 核 16G，本机同时跑着 5 个应用容器）：
                    串行      11:20
                    fork=4     6:16
                    fork=6     5:53   （只快 23 秒，却要多占 50% 的并发容器内存）
                  瓶颈在 Docker 的内存与 IO 而不是 CPU，所以加到核数只会互相拖慢并让超时更易抖动。
                  要改这个数字请先重新量一遍并更新上表，别凭感觉调。
                  排障：`mvn test -DforkCount=1` 可退回串行复现问题。
                -->
                <configuration>
                    <forkCount>4</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.2.4</version>
                <!-- 启动类的全类名 -->
                <configuration>
                    <mainClass>com.jbk.JbkApplication</mainClass>
                    <!-- 约束：JVM 默认编码非 UTF-8 时中文序列化会 500，须强制 UTF-8（物业项目已踩坑） -->
                    <jvmArguments>-Dfile.encoding=UTF-8</jvmArguments>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <nonFilteredFileExtensions>
                        <nonFilteredFileExtension>xlsx</nonFilteredFileExtension>
                    </nonFilteredFileExtensions>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/java</directory>
                <includes>
